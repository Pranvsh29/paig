        <mxCell id="e_p3_up_m" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_proc" target="p3_join"><mxGeometry relative="1" as="geometry"/></mxCell>
