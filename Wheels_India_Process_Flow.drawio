        <mxCell id="e_p2_int_dn" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;startArrow=classic;strokeColor=#0E8088;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="int1" target="sap_pm"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- P2 → P3 -->
        <mxCell id="e_23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_eng" target="p3_split"><mxGeometry relative="1" as="geometry"/></mxCell>

