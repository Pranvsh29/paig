        <mxCell id="e_p3_dn" value="Make" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_split" target="p3_mfg"><mxGeometry relative="1" as="geometry"/></mxCell>

