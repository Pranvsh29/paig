        <mxCell id="e_p2b" value="Yes (new product)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#B85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_dec" target="p2_eng"><mxGeometry relative="1" as="geometry"/></mxCell>

