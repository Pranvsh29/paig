        <!-- 6-monthly revision loop -->
        <mxCell id="e_loop" value="feeds back" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;startArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=10;dashed=1;fontColor=#B85450;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p4_loop" target="p5_send">
